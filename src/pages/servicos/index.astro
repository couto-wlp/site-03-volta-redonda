---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Cta from '../../components/Cta.astro';

const servicos = await getCollection('servicos');
---

<Layout title="Nossos Serviços - Aluguel de Caçambas">
	<div class="text-center mb-16">
		<h1 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight text-gray-900 mb-6">
			Nossas <span class="text-primary">Caçambas</span>
		</h1>
		<p class="max-w-3xl mx-auto text-lg md:text-xl text-gray-600">
			Confira nossos modelos de caçambas ideais para a sua obra ou reforma. Temos soluções práticas, seguras e de diferentes tamanhos.
		</p>
	</div>
	
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12 mb-32">
		{servicos.map((servico: CollectionEntry<'servicos'>) => (
			<a href={`/servicos/${servico.slug}`} class="flex flex-col bg-gray-50 border border-gray-100 rounded-3xl overflow-hidden shadow-sm hover:scale-105 transition-all hover:shadow-xl hover:border-primary/30 group relative">
				{servico.data.image && (
					<div class="w-full h-72 flex items-center justify-center pt-2 px-2 pb-0 overflow-visible">
						<img src={servico.data.image} alt={servico.data.title} loading="lazy" decoding="async" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 mix-blend-multiply brightness-110 contrast-125 scale-[.95]" />
					</div>
				)}
				<div class="px-10 pb-10 pt-2 md:px-12 md:pb-12 md:pt-4 flex flex-col flex-grow">
					<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-4">{servico.data.title}</h3>
					<p class="text-gray-600 text-lg mb-8">{servico.data.description}</p>
					<div class="mt-auto w-full">
						<span class="block w-full text-center bg-primary text-white py-3 rounded-xl text-lg font-bold tracking-tighter shadow-md transition-all hover:scale-[1.02]">Mais Informações</span>
					</div>
				</div>
			</a>
		))}
	</div>

	<Cta 
		title="Pronto para pedir sua " 
		highlight="caçamba?" 
		subtitle="Escolha o tamanho ideal e fale com nossa equipe para agendar a entrega imediata." 
	/>
</Layout>
