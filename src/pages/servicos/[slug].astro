---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((entry: CollectionEntry<'servicos'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'servicos'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description}>
	
	<!-- Hero do Serviço -->
	<div class="bg-orange-100 pt-28 pb-10 md:pt-36 md:pb-12 text-center mb-12 relative overflow-hidden -mt-24 md:-mt-32" style="width: 100vw; margin-left: calc(50% - 50vw);">
		<div class="relative z-10 max-w-4xl mx-auto px-6">
			<span class="inline-block bg-white text-primary font-black tracking-tighter px-5 py-2 rounded-full mb-8 text-sm uppercase shadow-sm">
				Serviço Especializado
			</span>
			<h1 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight mb-8 text-gray-900">
				{entry.data.title}
			</h1>
			<p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
				{entry.data.description}
			</p>
			<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="https://wa.me/5584998035361" class="bg-primary text-white px-8 py-4 rounded-xl text-[17px] font-black tracking-tighter hover:scale-105 active:scale-95 transition-transform shadow-lg shadow-primary/20 flex items-center justify-center gap-2 w-full sm:w-auto">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
					Chamar no WhatsApp
				</a>
				<button onclick="window.scrollBy({top: 400, behavior: 'smooth'})" class="bg-white text-gray-900 px-8 py-4 rounded-xl text-[17px] font-black tracking-tighter border border-gray-200 hover:bg-gray-50 hover:scale-105 active:scale-95 transition-all shadow-sm w-full sm:w-auto">
					Ver Caçamba
				</button>
			</div>
		</div>
	</div>

	<!-- Conteúdo Detalhado -->
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-16 mb-12">
		<div class="lg:col-span-2">
			
			<article class="prose prose-lg text-gray-600 prose-headings:font-black prose-headings:tracking-tighter prose-headings:text-gray-900 max-w-none prose-a:text-primary prose-a:font-bold hover:prose-a:text-primary mb-20 prose-p:leading-relaxed">
				<Content />
			</article>

			<!-- Especificações e Benefícios -->
			<div class="bg-gray-50 p-10 md:p-12 rounded-[32px] border border-gray-100 hover:shadow-xl transition-shadow">
				<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-8">Benefícios e Aplicações</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-10">
					<div>
						<h4 class="text-[22px] font-black tracking-tighter text-gray-900 mb-2 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Praticidade
						</h4>
						<p class="text-gray-600 text-lg leading-relaxed">Equipamento projetado para facilitar o carregamento e não atrapalhar o trânsito da via.</p>
					</div>
					<div>
						<h4 class="text-[22px] font-black tracking-tighter text-gray-900 mb-2 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Agilidade
						</h4>
						<p class="text-gray-600 text-lg leading-relaxed">Logística inteligente para entrega rápida e troca imediata quando a caçamba encher.</p>
					</div>
					<div>
						<h4 class="text-[22px] font-black tracking-tighter text-gray-900 mb-2 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Conformidade
						</h4>
						<p class="text-gray-600 text-lg leading-relaxed">Pintura e faixas refletivas exigidas pelos órgãos de fiscalização de Volta Redonda.</p>
					</div>
					<div>
						<h4 class="text-[22px] font-black tracking-tighter text-gray-900 mb-2 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Sustentabilidade
						</h4>
						<p class="text-gray-600 text-lg leading-relaxed">Garantia de que 100% dos resíduos gerados vão para aterros credenciados locais.</p>
					</div>
				</div>
			</div>

			<!-- FAQ Section -->
			<div class="mt-20">
				<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-8">Perguntas Frequentes</h3>
				<div class="space-y-2">
					<details class="group bg-white border border-gray-200 rounded-[24px] p-6 shadow-sm open:border-primary transition-colors cursor-pointer">
						<summary class="flex justify-between items-center font-black text-lg text-gray-900 list-none outline-none">
							Como escolho o tamanho certo da caçamba?
							<span class="transition-transform group-open:rotate-180 text-primary">
								<svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
							</span>
						</summary>
						<p class="text-gray-600 mt-4 text-lg leading-relaxed cursor-text">
							O tamanho ideal depende do volume de entulho da sua obra. A caçamba de 4m³ é perfeita para reformas residenciais e pequenos reparos. Já as de 5m³ e superiores são indicadas para construções completas e demolições maiores. Na dúvida, nossa equipe pode ajudar a calcular via WhatsApp.
						</p>
					</details>
					
					<details class="group bg-white border border-gray-200 rounded-[24px] p-6 shadow-sm open:border-primary transition-colors cursor-pointer">
						<summary class="flex justify-between items-center font-black text-lg text-gray-900 list-none outline-none">
							O que não posso descartar na caçamba?
							<span class="transition-transform group-open:rotate-180 text-primary">
								<svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
							</span>
						</summary>
						<p class="text-gray-600 mt-4 text-lg leading-relaxed cursor-text">
							É proibido o descarte de lixo orgânico doméstico, pneus, produtos químicos perigosos, tintas líquidas, amianto ou lixo hospitalar. Aceitamos restos de alvenaria, gesso, madeira, plástico, papelão e terra limpa.
						</p>
					</details>
					
					<details class="group bg-white border border-gray-200 rounded-[24px] p-6 shadow-sm open:border-primary transition-colors cursor-pointer">
						<summary class="flex justify-between items-center font-black text-lg text-gray-900 list-none outline-none">
							Quanto tempo a caçamba pode ficar no local?
							<span class="transition-transform group-open:rotate-180 text-primary">
								<svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
							</span>
						</summary>
						<p class="text-gray-600 mt-4 text-lg leading-relaxed cursor-text">
							O período padrão de locação é de 3 a 7 dias, dependendo da necessidade da sua obra e do local de instalação (se for em via pública, seguimos rigorosamente as regras de trânsito de Volta Redonda).
						</p>
					</details>

					<details class="group bg-white border border-gray-200 rounded-[24px] p-6 shadow-sm open:border-primary transition-colors cursor-pointer">
						<summary class="flex justify-between items-center font-black text-lg text-gray-900 list-none outline-none">
							Preciso de autorização da prefeitura para colocar na rua?
							<span class="transition-transform group-open:rotate-180 text-primary">
								<svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
							</span>
						</summary>
						<p class="text-gray-600 mt-4 text-lg leading-relaxed cursor-text">
							Nós mesmos orientamos você sobre as normas de Volta Redonda no momento da locação. Nossos motoristas são treinados para posicionar a caçamba apenas em locais permitidos, com as devidas faixas refletivas de segurança.
						</p>
					</details>

					<details class="group bg-white border border-gray-200 rounded-[24px] p-6 shadow-sm open:border-primary transition-colors cursor-pointer">
						<summary class="flex justify-between items-center font-black text-lg text-gray-900 list-none outline-none">
							O que acontece se a caçamba encher antes do prazo?
							<span class="transition-transform group-open:rotate-180 text-primary">
								<svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
							</span>
						</summary>
						<p class="text-gray-600 mt-4 text-lg leading-relaxed cursor-text">
							Caso a caçamba atinja sua capacidade máxima (nível da borda) antes do período contratado, basta nos avisar. Agendamos a retirada e, caso sua obra ainda precise, realizamos a substituição imediata por outra caçamba vazia.
						</p>
					</details>
				</div>
			</div>
		</div>

		<!-- Sidebar de Fechamento (CTA) -->
		<div>
			<div class="sticky top-32 bg-orange-100 rounded-[32px] p-8 md:p-10 shadow-2xl text-center border border-orange-200/50">
				<span class="block text-primary font-black tracking-widest uppercase text-[12px] mb-2">Orçamento Gratuito</span>
				<h3 class="text-[24px] md:text-[26px] font-black tracking-tighter text-gray-900 mb-6 leading-[1.1]">Interessado neste modelo?</h3>
				
				<div class="space-y-4">
					<a href="https://wa.me/5584998035361" class="flex items-center justify-center gap-3 w-full bg-primary text-white p-3.5 rounded-xl text-[16px] font-black tracking-tighter hover:brightness-110 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-primary/20">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
						Pedir no WhatsApp
					</a>
					
					<a href="https://wa.me/5584998035361" class="flex items-center justify-center gap-3 w-full bg-white border border-gray-200 text-gray-900 p-3.5 rounded-xl font-black tracking-tighter text-[16px] hover:bg-gray-50 transition-all shadow-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
						Ligar Agora
					</a>
				</div>
				
				<div class="mt-6 pt-5 border-t border-orange-200">
					<p class="text-[14px] text-gray-500 font-medium mb-1.5">Dúvidas? Fale com um especialista.</p>
					<p class="text-[20px] font-black text-gray-900">(84) 99803-5361</p>
				</div>
			</div>
		</div>
	</div>

</Layout>
