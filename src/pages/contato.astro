---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contato - DiskCaçamba">
	<div class="text-center mb-16">
		<h1 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight text-gray-900 mb-6">
			Fale <span class="text-primary">Conosco</span>
		</h1>
		<p class="max-w-3xl mx-auto text-lg md:text-xl text-gray-600">
			Fale com nossa equipe e solicite um orçamento de caçamba rapidamente. Estamos sempre prontos para oferecer o melhor atendimento possível.
		</p>
	</div>
	
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
		<!-- NAP Info -->
		<div class="space-y-10">
			<div>
				<h2 class="text-3xl font-black tracking-tighter text-gray-900 mb-4">Informações de Contato</h2>
				<p class="text-gray-600 text-lg mb-8">
					Nossa equipe especializada está pronta para te atender e tirar todas as suas dúvidas. Escolha o canal de sua preferência:
				</p>
				
				<div class="space-y-6 text-base text-gray-700 bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:shadow-lg transition-all">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
						</div>
						<div>
							<strong class="block text-gray-900 text-xl font-black tracking-tighter mb-1">DiskCaçamba Matriz</strong>
							Av. Lucas Evangelista de Oliveira Franco, 890 - Jardim Paraíba<br>Volta Redonda - RJ, 27215-630
						</div>
					</div>
					<hr class="border-gray-200">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
						</div>
						<div>
							<strong class="block text-gray-900 text-xl font-black tracking-tighter mb-1">Telefones</strong>
							<a href="tel:84998035361" class="hover:text-primary transition-colors block">(84) 99803-5361</a>
							<a href="https://wa.me/5584998035361" class="hover:text-primary transition-colors block">(84) 99803-5361 (Plantão WhatsApp)</a>
						</div>
					</div>
					<hr class="border-gray-200">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						</div>
						<div>
							<strong class="block text-gray-900 text-xl font-black tracking-tighter mb-1">Email</strong>
							<a href="mailto:orcamento@diskcacambavr.com.br" class="hover:text-primary transition-colors">orcamento@diskcacambavr.com.br</a>
						</div>
					</div>
					<hr class="border-gray-200">
					<div class="flex items-start gap-4">
						<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						</div>
						<div>
							<strong class="block text-gray-900 text-xl font-black tracking-tighter mb-1">Horário</strong>
							<span class="block">Seg - Sex: 08:00 - 18:00</span>
							<span class="block text-sm text-gray-500 mt-1">Sábado: 08:00 - 12:00</span>
						</div>
					</div>
				</div>
			</div>

			<div class="bg-gray-50 border border-gray-100 p-8 rounded-3xl text-center shadow-lg">
				<h3 class="text-2xl font-black tracking-tighter text-gray-900 mb-3">Orçamento Express</h3>
				<p class="text-gray-600 text-base mb-6">A forma mais rápida de alugar sua caçamba. Resposta em até 5 minutos.</p>
				<a href="https://wa.me/5584998035361" class="inline-flex justify-center items-center w-full bg-primary text-white p-4 rounded-xl text-lg font-black tracking-tighter hover:brightness-110 hover:scale-105 active:scale-95 transition-all shadow-xl shadow-primary/20">
					Chamar no WhatsApp
				</a>
			</div>
		</div>

		<!-- Formulário Funcional de Alta Conversão -->
		<div class="bg-white p-8 md:p-10 rounded-3xl border border-gray-200 shadow-xl h-fit sticky top-32">
			<h2 class="text-3xl font-black tracking-tighter text-gray-900 mb-6">Envie uma Mensagem</h2>
			<form class="space-y-6">
				<div>
					<label class="block text-gray-900 font-bold mb-2 text-base">Seu Nome *</label>
					<input type="text" required class="w-full bg-gray-50 border border-gray-300 rounded-lg p-4 text-base focus:ring-4 focus:ring-primary/20 focus:border-primary transition-all outline-none" placeholder="Como devemos chamá-lo?">
				</div>
				<div>
					<label class="block text-gray-900 font-bold mb-2 text-base">Seu Telefone/WhatsApp *</label>
					<input type="tel" required class="w-full bg-gray-50 border border-gray-300 rounded-lg p-4 text-base focus:ring-4 focus:ring-primary/20 focus:border-primary transition-all outline-none" placeholder="(84) 99803-5361">
				</div>
				<div>
					<label class="block text-gray-900 font-bold mb-2 text-base">Bairro da Obra</label>
					<input type="text" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-4 text-base focus:ring-4 focus:ring-primary/20 focus:border-primary transition-all outline-none" placeholder="Ex: Retiro">
				</div>
				<div>
					<label class="block text-gray-900 font-bold mb-2 text-base">Sua Mensagem</label>
					<textarea class="w-full bg-gray-50 border border-gray-300 rounded-lg p-4 text-base h-32 focus:ring-4 focus:ring-primary/20 focus:border-primary transition-all outline-none resize-none" placeholder="Gostaria de solicitar uma caçamba para amanhã..."></textarea>
				</div>
				<button type="submit" class="w-full bg-primary text-white font-black tracking-tighter p-4 rounded-xl text-xl hover:brightness-110 hover:scale-105 active:scale-95 transition-all shadow-xl shadow-primary/20 mt-4">
					Enviar Solicitação
				</button>
			</form>
		</div>
	</div>

	<!-- Mapa -->
	<div class="mt-24">
		<h2 class="text-3xl font-black tracking-tighter text-gray-900 mb-8 text-center">Nossa Localização</h2>
		<div class="w-full h-[400px] md:h-[500px] rounded-3xl overflow-hidden shadow-xl border border-gray-200">
			<iframe 
				src="https://maps.google.com/maps?q=Av.+Lucas+Evangelista+de+Oliveira+Franco,+890+-+Jardim+Para%C3%ADba,+Volta+Redonda+-+RJ&t=&z=15&ie=UTF8&iwloc=&output=embed" 
				width="100%" 
				height="100%" 
				style="border:0;" 
				allowfullscreen="" 
				loading="lazy" 
				referrerpolicy="no-referrer-when-downgrade">
			</iframe>
		</div>
	</div>
</Layout>
