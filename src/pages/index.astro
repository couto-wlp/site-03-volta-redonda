---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';

const servicos = await getCollection('servicos');
const featuredServicos = servicos.slice(0, 6);
---

<Layout title="Aluguel de Caçambas Volta Redonda">
	
	<!-- Hero Section -->
	<section class="-mt-24 md:-mt-32 w-screen relative left-1/2 -translate-x-1/2 bg-orange-100 pt-[105px] md:pt-[125px] pb-16 overflow-hidden">
		<div class="container mx-auto px-6 md:px-12 relative z-10">
			<div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
				
				<!-- Text Content -->
				<div class="flex flex-col items-center text-center lg:items-start lg:text-left max-w-2xl w-full lg:w-1/2">
					<span class="inline-block bg-white text-black font-bold tracking-wide mb-3 md:mb-6 text-sm uppercase px-5 py-2 rounded-full border-0 shadow-sm">
						Soluções em Caçambas para Volta Redonda
					</span>
					<h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tighter leading-[1.05] text-[#0F172A]">
						Aluguel de Caçamba <br />
						em <span class="text-black">Volta Redonda</span>
					</h1>
					<p class="text-base md:text-lg text-gray-600 mt-3 md:mt-6 max-w-2xl leading-snug md:leading-relaxed font-medium">
						Fale com a gente agora mesmo! Clique no botão abaixo para ir direto ao WhatsApp.
					</p>
					<div class="mt-5 md:mt-10 flex flex-col sm:flex-row justify-center lg:justify-start gap-3 sm:gap-4 w-full sm:w-auto">
						<a href="https://wa.me/5584998035361" class="inline-flex justify-center items-center bg-orange-500 text-white px-8 py-[19px] sm:py-4 rounded-xl text-[21px] sm:text-lg font-bold tracking-tighter hover:brightness-110 transition-all shadow-lg shadow-orange-500/30 hover:scale-105 active:scale-95">
							Chamar no WhatsApp
						</a>
						<a href="/servicos" class="inline-flex justify-center items-center bg-white border border-gray-200 text-[#0F172A] px-8 py-[19px] sm:py-4 rounded-xl text-[21px] sm:text-lg font-bold tracking-tighter hover:border-gray-300 transition-all hover:bg-gray-50 hover:scale-105 active:scale-95">
							Ver Serviços
						</a>
					</div>
				</div>

				<!-- Image Content -->
				<div class="w-full lg:w-1/2 flex justify-center lg:justify-end mt-3 lg:mt-0 relative">
					<img src="/caminhao-cacamba.jpg" alt="Caminhão caçamba em Volta Redonda" class="w-full max-w-[600px] h-auto object-cover rounded-[2rem] shadow-2xl relative z-10" style="aspect-ratio: 4/3;" />
				</div>

			</div>
		</div>
	</section>

	<!-- Serviços (Movido para abaixo do Hero) -->
	<section class="bg-white pt-8 pb-16 md:pt-12 md:pb-24 w-screen relative left-1/2 -translate-x-1/2">
		<div class="container mx-auto px-6 md:px-12">
			<div class="flex flex-col items-center text-center mb-16">
				<h2 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight text-gray-900">Nossas <span class="text-primary">Caçambas</span></h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12 mb-12">
				{featuredServicos.map((servico: CollectionEntry<'servicos'>) => (
					<a href={`/servicos/${servico.slug}`} class="flex flex-col bg-gray-50 border border-gray-100 rounded-3xl overflow-hidden shadow-sm hover:scale-105 transition-all hover:shadow-xl hover:border-primary/30 group relative">
						{servico.data.image && (
							<div class="w-full h-72 flex items-center justify-center pt-2 px-2 pb-0 overflow-visible">
								<img src={servico.data.image} alt={servico.data.title} class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 mix-blend-multiply brightness-110 contrast-125 scale-[.95]" />
							</div>
						)}
						<div class="px-10 pb-10 pt-2 md:px-12 md:pb-12 md:pt-4 flex flex-col flex-grow">
							<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-4">{servico.data.title}</h3>
							<p class="text-gray-600 text-lg mb-8">{servico.data.description}</p>
							<div class="mt-auto">
								<span class="inline-block bg-primary text-white px-8 py-2 rounded-xl text-lg font-bold tracking-tighter shadow-md transition-all">Mais Informações</span>
							</div>
						</div>
					</a>
				))}
			</div>
			<div class="text-center">
				<a href="/servicos" class="inline-block bg-primary text-white px-10 py-4 rounded-xl text-xl font-bold tracking-tighter hover:brightness-110 hover:scale-105 active:scale-95 transition-all shadow-md">
					Ver Todos os Serviços
				</a>
			</div>
		</div>
	</section>

	<!-- Diferenciais Grid -->
	<section class="bg-orange-100 py-16 md:py-24 w-screen relative left-1/2 -translate-x-1/2">
		<div class="container mx-auto px-6 md:px-12">
			<div class="text-center mb-16 md:mb-24">
				<h2 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight text-gray-900">
					Por que somos sua <span class="text-primary">melhor opção</span>
				</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
				<div class="bg-white border border-gray-200 rounded-3xl p-10 md:p-12 shadow-sm flex flex-col items-start text-left hover:scale-105 transition-all hover:shadow-xl hover:border-primary/30">
					<div class="w-16 h-16 bg-[#FDF0E7] rounded-full flex items-center justify-center mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-4 leading-tight">Entrega em 2h</h3>
					<p class="text-gray-600 text-lg">O tempo da sua obra vale ouro. Com frota exclusiva e rotas otimizadas, garantimos que a caçamba chegue ao seu endereço muito rapidamente, sem atrasos.</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-3xl p-10 md:p-12 shadow-sm flex flex-col items-start text-left hover:scale-105 transition-all hover:shadow-xl hover:border-primary/30">
					<div class="w-16 h-16 bg-[#FDF0E7] rounded-full flex items-center justify-center mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
					</div>
					<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-4 leading-tight">Regularizada</h3>
					<p class="text-gray-600 text-lg">Trabalhe com tranquilidade! Somos totalmente regularizados na Prefeitura de Volta Redonda e órgãos ambientais. Emitimos seu MTR para garantir total conformidade e segurança do projeto.</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-3xl p-10 md:p-12 shadow-sm flex flex-col items-start text-left hover:scale-105 transition-all hover:shadow-xl hover:border-primary/30">
					<div class="w-16 h-16 bg-[#FDF0E7] rounded-full flex items-center justify-center mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="text-[28px] font-black tracking-tighter text-gray-900 mb-4 leading-tight">O Melhor Preço</h3>
					<p class="text-gray-600 text-lg">Unimos excelência de serviço a um preço justo para a sua obra. Oferecemos valores competitivos e total flexibilidade de pagamento no Pix ou cartão parcelado.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Sobre Nós (50/50) -->
	<section class="bg-white pt-8 pb-16 md:pt-12 md:pb-24 w-screen relative left-1/2 -translate-x-1/2">
		<div class="container mx-auto px-6 md:px-12">

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="order-2 lg:order-1">

					<h3 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight text-black mb-6">
						Autoridade quando o assunto é <span class="text-primary">aluguel de caçambas.</span>
					</h3>
					<p class="text-lg text-gray-600 mb-6 leading-relaxed">
						A Aluguel Caçambas RV atua desde 2013 oferecendo soluções rápidas e seguras no aluguel de caçambas em Volta Redonda - RJ. Atendemos obras residenciais, comerciais e grandes projetos com total responsabilidade ambiental e frota própria.
					</p>
					<p class="text-lg text-gray-600 mb-10 leading-relaxed font-medium">
						Para conhecer melhor nossa história, clique no botão abaixo e acesse a página Sobre.
					</p>
					<a href="/sobre" class="inline-flex justify-center items-center bg-primary text-white px-8 py-3 rounded-xl text-xl font-bold tracking-tighter hover:brightness-110 hover:scale-105 active:scale-95 transition-all shadow-xl shadow-primary/20">
						Conheça nossa História
					</a>
				</div>
				<div class="order-1 lg:order-2">
					<img src="/sobre-cacamba.webp" alt="Equipe DiskCaçamba" class="w-full h-[500px] object-cover rounded-3xl shadow-2xl" />
				</div>
			</div>
		</div>
	</section>

	<!-- Depoimentos -->
	<section class="bg-orange-100 py-16 md:py-24 w-screen relative left-1/2 -translate-x-1/2">
		<div class="container mx-auto px-6 md:px-12">
			<h2 class="text-[31px] md:text-[43px] font-black tracking-tighter leading-tight text-gray-900 mb-12 text-center">Depoimentos dos Nossos Clientes</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
			<div class="bg-white border border-gray-200 rounded-3xl p-10 md:p-12 shadow-md hover:scale-105 transition-all">
				<div class="flex text-orange-500 mb-6 text-[28px]">★★★★★</div>
				<p class="text-gray-600 text-lg mb-8 leading-relaxed">
					"Trabalho com obras há anos e nunca vi uma entrega tão rápida. Pedi a caçamba de manhã e à tarde já estava na obra. Preço justo e motorista muito educado."
				</p>
				<div class="flex items-center gap-5">
					<div class="relative shrink-0">
						<img src="/images/carlos.png" alt="Carlos Freitas" class="w-16 h-16 rounded-full object-cover shadow-sm" />
						<div class="absolute -bottom-1 -right-1 w-6 h-6 bg-white rounded-full flex items-center justify-center p-[2px] shadow-sm">
							<svg viewBox="0 0 24 24" class="w-full h-full" fill="url(#ig-grad)">
								<defs>
								<linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
									<stop offset="0%" stop-color="#f09433"/><stop offset="25%" stop-color="#e6683c"/><stop offset="50%" stop-color="#dc2743"/><stop offset="75%" stop-color="#cc2366"/><stop offset="100%" stop-color="#bc1888"/>
								</linearGradient>
								</defs>
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
							</svg>
						</div>
					</div>
					<div>
						<h4 class="font-bold text-gray-900 text-lg">Carlos Freitas</h4>
						<span class="text-gray-500 text-sm">Pedreiro, Aterrado</span>
					</div>
				</div>
			</div>
			<div class="bg-white border border-gray-200 rounded-3xl p-10 md:p-12 shadow-md hover:scale-105 transition-all">
				<div class="flex text-orange-500 mb-6 text-[28px]">★★★★★</div>
				<p class="text-gray-600 text-lg mb-8 leading-relaxed">
					"Precisava limpar o quintal depois de uma pequena reforma. A caçamba de 4m³ foi perfeita. Atendimento via WhatsApp muito prático e rápido. Recomendo demais!"
				</p>
				<div class="flex items-center gap-5">
					<div class="relative shrink-0">
						<img src="/images/ana.png" alt="Ana Souza" class="w-16 h-16 rounded-full object-cover shadow-sm" />
						<div class="absolute -bottom-1 -right-1 w-6 h-6 bg-white rounded-full flex items-center justify-center shadow-sm">
							<svg viewBox="0 0 24 24" class="w-full h-full text-[#1877F2]" fill="currentColor">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</div>
					</div>
					<div>
						<h4 class="font-bold text-gray-900 text-lg">Ana Souza</h4>
						<span class="text-gray-500 text-sm">Moradora do bairro Vila Santa Cecília, VR</span>
					</div>
				</div>
			</div>
			<div class="bg-white border border-gray-200 rounded-3xl p-10 md:p-12 shadow-md hover:scale-105 transition-all">
				<div class="flex text-orange-500 mb-6 text-[28px]">★★★★★</div>
				<p class="text-gray-600 text-lg mb-8 leading-relaxed">
					"Como engenheiro, exijo pontualidade e descarte correto. A empresa cumpriu tudo no prazo e me entregou a caçamba certa para o volume de entulho. Ganharam minha confiança."
				</p>
				<div class="flex items-center gap-5">
					<div class="relative shrink-0">
						<img src="/images/rodrigo.png" alt="Rodrigo T. Machado" class="w-16 h-16 rounded-full object-cover shadow-sm" />
						<div class="absolute -bottom-1 -right-1 w-6 h-6 bg-white rounded-full flex items-center justify-center p-[4px] shadow-sm">
							<svg viewBox="0 0 24 24" class="w-full h-full text-black" fill="currentColor">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</div>
					</div>
					<div>
						<h4 class="font-bold text-gray-900 text-lg">Rodrigo T. Machado</h4>
						<span class="text-gray-500 text-sm">Engenheiro Civil, Jardim Amália</span>
					</div>
				</div>
			</div>
		</div>
		</div>
	</section>











	<!-- Chamada de Contato Final -->
	<Cta />

</Layout>
