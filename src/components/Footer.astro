            </div>
            <div>
              <span class="text-[17px] md:text-sm text-gray-600 font-medium block mb-1">WhatsApp 24h</span>
              <a href="https://wa.me/5584998035361" target="_blank" class="text-[17px] md:text-sm text-gray-600 font-medium hover:text-primary transition-colors">(84) 99803-5361</a>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <div class="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center shrink-0 mt-1 text-primary group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <span class="text-[17px] md:text-sm text-gray-600 font-medium block mb-1">E-mail Comercial</span>
              <a href="mailto:contato@diskcacambavr.com.br" class="text-[17px] md:text-sm text-gray-600 font-medium hover:text-primary transition-colors">contato@diskcacambavr.com.br</a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Col 4: Operação & Meio Ambiente -->
      <div>
        <h3 class="text-[17px] md:text-sm font-black text-primary uppercase tracking-widest mb-6">Operação & Meio Ambiente</h3>
        <div class="flex items-start gap-4 mb-8">
          <div class="text-primary mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <p class="text-[17px] md:text-sm text-gray-600 leading-relaxed font-medium">
            Av. Lucas Evangelista de Oliveira Franco, 890 - Jardim Paraíba<br/>
            Volta Redonda - RJ, 27215-630
          </p>
        </div>

        <div class="flex flex-col gap-3 text-[16px] md:text-[13px] text-gray-600 font-medium pl-9">
          <div class="flex flex-col border-b border-gray-200 pb-3">
            <span class="text-[15px] md:text-xs text-gray-500 mb-1">Licença SMMA:</span>
            <span class="text-gray-900 font-bold">L.O. nº 0387/24</span>
