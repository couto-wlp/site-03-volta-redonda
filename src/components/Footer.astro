    <!-- Copyright -->
    <div class="border-t border-gray-200 mt-16 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[17px] md:text-sm text-gray-500 font-medium">
      <div>&copy; {new Date().getFullYear()} DiskCaçamba. Todos os direitos reservados.</div>
      <div class="flex gap-6">
        <a href="/privacidade" class="hover:text-primary transition-colors">Política de Privacidade</a>
        <a href="/termos" class="hover:text-primary transition-colors">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
