        </div>
      </div>

      <!-- Col 2: Navegação Rápida -->
      <div>
        <h3 class="text-[17px] md:text-sm font-black text-primary uppercase tracking-widest mb-6">Navegação Rápida</h3>
        <ul class="space-y-4 text-[17px] md:text-sm text-gray-600 font-medium">
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 bg-primary block"></span>
            <a href="/" class="hover:text-primary transition-colors">Início</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 bg-primary block"></span>
            <a href="/servicos" class="hover:text-primary transition-colors">Nossos Serviços</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 bg-primary block"></span>
            <a href="/sobre" class="hover:text-primary transition-colors">Sobre Nós</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 bg-primary block"></span>
            <a href="/bairros" class="hover:text-primary transition-colors">Bairros de Atuação</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 bg-primary block"></span>
            <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 bg-primary block"></span>
            <a href="/contato" class="hover:text-primary transition-colors">Contato</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Suporte & Logística -->
      <div>
        <h3 class="text-[17px] md:text-sm font-black text-primary uppercase tracking-widest mb-6">Suporte & Logística</h3>
        <ul class="space-y-6">
          <li class="flex items-start gap-4 group">
            <div class="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center shrink-0 mt-1 text-primary group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <span class="text-[17px] md:text-sm text-gray-600 font-medium block mb-1">Ligação</span>
              <a href="tel:84998035361" class="text-[17px] md:text-sm text-gray-600 font-medium hover:text-primary transition-colors">(84) 99803-5361</a>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <div class="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center shrink-0 mt-1 text-primary group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all">
